{
  "name": "gongshi-client",
  "version": "1.0.7",
  "private": true,
  "description": "初中数理化公式手册 - 桌面瘦客户端（连接 NAS 上的服务）",
  "main": "main.js",
  "author": {
    "name": "zhtvwn",
    "email": "4420651@qq.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhtvwn/gongshi.git"
  },
  "scripts": {
    "start": "electron .",
    "icons": "node scripts/gen-icons.js",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist": "electron-builder --win --mac"
  },
  "devDependencies": {
    "electron": "27.3.11",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.zhtvwn.gongshi.client",
    "productName": "Gongshi",
    "copyright": "Copyright © zhtvwn",
    "asar": true,
    "publish": null,
    "files": [
      "main.js",
      "preload.js",
      "setup.html",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "mac": {
      "icon": "build/icon.icns",
      "minimumSystemVersion": "10.15",
      "category": "public.app-category.education",
      "target": [
        { "target": "dmg", "arch": ["x64"] },
        { "target": "zip", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "公式手册",
      "language": "2052"
    },
    "dmg": {
      "title": "公式手册 ${version}",
      "contents": [
        { "x": 130, "y": 220 },
        { "x": 410, "y": 220, "type": "link", "path": "/Applications" }
      ]
    }
  }
}
